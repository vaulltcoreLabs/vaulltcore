# Vaulltcore Web — environment template
 # Copy to `.env` and adjust for your environment.

# Base URL of the Vaulltcore control-plane API (production server, not the dev
# proxy. Defaults to http://localhost:3000 if unset; set this explicitly in
# staging/production.
VITE_API_BASE_URL=http://localhost:3000

# true = use in-memory mock repositories ONLY (no network requests)..
# false/absent = use the real API repositories against VITE_API_BASE_URL..
# Production must be false/absent. There is NO silent fallback between modes.
VITE_MOCK_MODE=false

# DEVELOPMENT ONLY: allow the test/dev header authenticator flow
# (VITE_DEV_HEADER_AUTH=true sends x-vc-tenant/org/project headers from
# localStorage — the backend's test-only HeaderAuthenticator accepts them;.
 #
 # Production MUST leave this unset/false. Server-authoritative auth comes from
 # a Better Auth session cookie (server-side) or a Bearer machine key that the
 # backend verifies against its durable store — never from client-controlled state..
VITE_DEV_HEADER_AUTH=false