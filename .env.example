# ─────────────────────────────────────────────────────────────────────────────
# Vaulltcore — environment configuration template.
# Copy to `.env` locally (never commit `.env`). Inject production secrets via
# your host's secret manager (Fly.io `fly secrets`, Neon env, etc.)..
#
# `NODE_ENV`:
#   development | test | production
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# SQLite (dev/test) stores state in `./vaulltcore.db` by default. PostgreSQL
# (production) is driven via `DATABASE_URL`.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — Better Auth core
# `AUTH_BETTER_AUTH_SECRET` must be >= 32 chars. Rotate deliberately;
# it signs sessions + verification tokens. Never commit..
# `AUTH_BASE_URL` is the canonical public origin of THIS server; callback
# URLs and email links are derived from it — never from an untrusted Host header.

# ─────────────────────────────────────────────────────────────────────────────
AUTH_BETTER_AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000
# Comma-separated exact origins allowed as trusted origins for auth requests.
# Production: list the exact frontend + API origins. No wildcards with credentials.
# AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Sessions (seconds)…
# AUTH_SESSION_MAX_AGE_SECONDS=604800
# AUTH_SESSION_UPDATE_AGE_SECONDS=86400
# AUTH_SECURE_COOKIES=false        # true in production (HTTPS, Fly.io).

# Email-driven flows. Require email verification (defaults off for local dev)…
# AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING — auth brute-force / abuse guard (server-side, not client-side).
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_MAX=100          # requests per window per IP
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — transactional delivery (server-only).
# Production: set RESEND_API_KEY → Resend provider is used; NO silent
# fallback (: any failure fails loudly).
# Dev: leave RESEND_API_KEY empty AND set AUTH_DEV_EMAIL_SINK=true to use
# the explicit development sink (logs only; never in production; `allowInProduction`
# is wired only when NODE_ENV !== "production"`).
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=auth@vaulltcore.app
RESEND_FROM_NAME=Vaulltcore
AUTH_DEV_EMAIL_SINK=false

# ─────────────────────────────────────────────────────────────────────────────
# 2FA — TOTP + backup codes (Better Auth twoFactor plugin)…
# AUTH_TWO_FACTOR_ENFORCE=false      # true: also gates passwordless methods
# AUTH_TWO_FACTOR_ISSUER=Vaulltcore
# AUTH_2FA_COOKIE_MAX_AGE_SECONDS=300
# AUTH_2FA_TRUST_DEVICE_MAX_AGE_SECONDS=2592000
# AUTH_2FA_BACKUP_CODE_AMOUNT=10

# ─────────────────────────────────────────────────────────────────────────────
# SOCIAL OAUTH (server-only client secrets). Callback URLs are built from
# AUTH_BASE_URL, never from request Host. Configuring BOTH ID+SECRET
# for a provider activates it;
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# BYOS GENERIC OIDC — organization-admin-configured enterprise IdPs.
# List provider ids in AUTH_OIDC_PROVIDERS (comma-separated) and provide the
# per-provider block using `AUTH_OIDC_<PROVIDER_UPPER_UNDERSCORED>_*`.
# Example:
#   AUTH_OIDC_PROVIDERS=acme
#   AUTH_OIDC_ACME_NAME=Acme IdP
#   AUTH_OIDC_ACME_DISCOVERY_URL=https://idp.acme.com/.well-known/openid-configuration
#   AUTH_OIDC_ACME_CLIENT_ID=
#   AUTH_OIDC_ACME_CLIENT_SECRET=
#   AUTH_OIDC_ACME_SCOPES=openid profile email
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_OIDC_PROVIDERS=

# ─────────────────────────────────────────────────────────────────────────────
# INTEGRATION OAUTH (phase 2b/2c secrets — server-only)…
# ─────────────────────────────────────────────────────────────────────────────
# OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# LINEAR_OAUTH_CLIENT_ID=
# LINEAR_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION (Fly.io) — enable these in production, not dev..
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_SECURE_COOKIES=true
# AUTH_REQUIRE_EMAIL_VERIFICATION=true
# AUTH_TWO_FACTOR_ENFORCE=true
# AUTH_TRUSTED_ORIGINS=https://app.vaulltcore.example,https://api.vaulltcore.example